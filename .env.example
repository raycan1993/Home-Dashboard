# ============================================================
# Home Dashboard - Docker stack configuration
#
# Copy this file to .env in the repository root and fill in the values.
# .env is ignored by git.
# ============================================================

# ------------- Public URL -----------------------------------------------------
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080

# ------------- Database -------------------------------------------------------
DB_PASSWORD=change-me

# ------------- Weather (MeteoSwiss, no API key) -------------------------------
# Users can switch the active location from the dashboard at runtime.
WEATHER_PLZ=8400000
WEATHER_CITY=Winterthur

# ------------- Trains (SBB / transport.opendata.ch, no key) -------------------
SBB_FROM=Winterthur
SBB_TO=Zürich HB
SBB_NUM_CONNECTIONS=15

# ------------- Logging --------------------------------------------------------
DEVELOPER_MODE=false
LOG_LEVEL=info
