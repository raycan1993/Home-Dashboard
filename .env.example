# ============================================================
# Home Dashboard — Docker stack configuration
#
# Copy this file to .env (same folder as docker-compose.yml) and fill in
# the required values. .env is in .gitignore — never commit it.
# ============================================================

# ------------- Public URL (must match what you type in the browser) -----------
# Default published port is 8080. To use port 80 instead, set:
#   WEB_PORT=80
#   PUBLIC_URL=http://localhost
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080

# ------------- Database password (you choose this) ----------------------------
# Used by Postgres on first start AND by the server to connect.
DB_PASSWORD=ThisIsNotAStrongPW!

# ------------- Token encryption key (32 bytes, base64) ------------------------
# Generate one in PowerShell:
#   $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
TOKEN_ENC_KEY=pB143MF+Txckcac9bxtDQEF2VeP7dVFUwDBVLJoPEKU=

# ------------- Weather (Open-Meteo, no API key) -------------------------------
WEATHER_LATITUDE=47.5022
WEATHER_LONGITUDE=8.7386
WEATHER_CITY=Winterthur

# ------------- Trains (SBB, no API key) ---------------------------------------
SBB_FROM=Winterthur
SBB_TO=Zürich HB
SBB_NUM_CONNECTIONS=5

# ------------- Microsoft Todo (optional) --------------------------------------
# Scopes to request: Tasks.ReadWrite, offline_access (nothing else).
# Register the redirect URI exactly as: ${PUBLIC_URL}/api/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_TODO_LIST_ID=

# ------------- Strava (optional) ----------------------------------------------
# Scopes: read,activity:read
# Authorization Callback Domain in Strava settings: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ------------- Bring (optional) -----------------------------------------------
BRING_EMAIL=
BRING_PASSWORD=
BRING_LIST_UUID=

# ------------- Logging --------------------------------------------------------
# DEVELOPER_MODE=true exposes /api/dev/logs (SSE log stream).
# Keep false unless actively debugging.
DEVELOPER_MODE=false
LOG_LEVEL=info
