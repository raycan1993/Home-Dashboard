# ============================================================
# Home Dashboard — environment configuration
#
# SECURITY:
#   1. Move this file to %USERPROFILE%\.home-dashboard\.env on Windows
#      so it isn't synced to OneDrive. Set HOME_DASHBOARD_ENV_FILE to point
#      at it, or rely on the default lookup order in src/config/env.ts.
#   2. NEVER commit a populated .env. The .gitignore guards against this.
#   3. Restrict file ACLs:
#        icacls "%USERPROFILE%\.home-dashboard\.env" /inheritance:r /grant:r "%USERNAME%:R"
# ============================================================

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# Use a least-privilege Postgres user, NOT the postgres superuser.
# Bind Postgres to 127.0.0.1 in postgresql.conf.
DATABASE_URL="postgresql://home_dashboard_app:CHANGE_ME@127.0.0.1:5432/home_dashboard?sslmode=prefer"

# ------------------------------------------------------------
# CRYPTO
# 32 random bytes, base64-encoded. Generate with PowerShell:
#   $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Rotation: change this and re-run the OAuth flows.
# ------------------------------------------------------------
TOKEN_ENC_KEY=""

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Bind interface — keep 127.0.0.1 for localhost-only.
HOST=127.0.0.1
# Single allowed origin for the SPA. No wildcards.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# WEATHER (Open-Meteo — no API key required)
# https://open-meteo.com — lookup coords at /en/docs/geocoding-api
# ------------------------------------------------------------
WEATHER_LATITUDE=47.5022
WEATHER_LONGITUDE=8.7386
WEATHER_CITY="Winterthur"

# ------------------------------------------------------------
# SBB / TRANSPORT (transport.opendata.ch — no key needed)
# ------------------------------------------------------------
SBB_FROM="Winterthur"
SBB_TO="Zürich HB"
SBB_NUM_CONNECTIONS=5

# ------------------------------------------------------------
# MICROSOFT TODO
# Register at https://portal.azure.com.
# REQUEST ONLY THESE SCOPES — NOTHING ELSE:
#   Tasks.ReadWrite, offline_access
# Do NOT request Mail.*, Files.*, User.Read.All etc.
# ------------------------------------------------------------
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID="common"
MS_REDIRECT_URI="http://127.0.0.1:3001/api/oauth/microsoft/callback"
MS_TODO_LIST_ID=""

# ------------------------------------------------------------
# BRING (groceries)
# ------------------------------------------------------------
BRING_EMAIL=""
BRING_PASSWORD=""
BRING_LIST_UUID=""

# ------------------------------------------------------------
# STRAVA
# Register at https://www.strava.com/settings/api.
# REQUEST ONLY: read,activity:read
# ------------------------------------------------------------
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://127.0.0.1:3001/api/oauth/strava/callback"

# ------------------------------------------------------------
# DEVELOPER MODE
# When true: SSE log stream is exposed on /api/dev/logs (localhost only).
# When false: dev endpoints return 404. Set to false in production.
# ------------------------------------------------------------
DEVELOPER_MODE=true
LOG_LEVEL=info
