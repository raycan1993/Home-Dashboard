# ============================================================
# Home Dashboard - server environment configuration
#
# For local dev: copy to server/.env, fill in DATABASE_URL,
# and run `npm run dev --workspace=server`.
#
# For Docker: the docker-compose.yml injects all vars directly.
# The server also looks for a file at %USERPROFILE%\.home-dashboard\.env
# (Windows) or $HOME/.home-dashboard/.env (Linux/macOS).
# ============================================================

# ------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------
DATABASE_URL="postgresql://home_dashboard_app:CHANGE_ME@127.0.0.1:5432/home_dashboard?sslmode=prefer"

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=3001
NODE_ENV=development
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------
# WEATHER (MeteoSwiss app API — no API key required)
# WEATHER_PLZ: 4-digit Swiss postal code (e.g. 8400 for Winterthur).
# Users can also switch location at runtime from the dashboard.
# ------------------------------------------------------------
WEATHER_PLZ=8400000
WEATHER_CITY="Winterthur"

# ------------------------------------------------------------
# SBB / TRANSPORT (transport.opendata.ch — no key needed)
# ------------------------------------------------------------
SBB_FROM="Winterthur"
SBB_TO="Zürich HB"
SBB_NUM_CONNECTIONS=5

# ------------------------------------------------------------
# DEVELOPER MODE
# DEVELOPER_MODE=true exposes /api/dev/logs (SSE log stream).
# Keep false in production.
# ------------------------------------------------------------
DEVELOPER_MODE=false
LOG_LEVEL=info
