// Prisma schema - single-user dashboard.
// The remaining upstream integrations (weather and trains) use only
// Postgres-backed response caching.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CacheEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  data      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("cache_entries")
}
